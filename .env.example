# Backend de datos: "twscrape" (scraping gratis, default) u "official" (X API v2,
# stub de Fase 2). Único punto de intercambio scraping ↔ API oficial.
PROVIDER_BACKEND=twscrape

# Cookies de sesión de una cuenta de X secundaria/descartable (backend twscrape).
# NUNCA commitear el .env real.
X_AUTH_TOKEN=
X_CT0=

# Bearer token de la X API v2 oficial (solo backend "official"; stub de Fase 2).
X_API_BEARER_TOKEN=

# Rutas de almacenamiento (el ledger de auditoría va separado del SQLite de datos).
AUDIT_DB_PATH=data/audit/ledger.db
DATA_DB_PATH=data/tweets.db
# Store de cuentas/cookies de twscrape (git-ignored; separado del ledger y de los datos).
ACCOUNTS_DB_PATH=data/accounts.db
# Raíz de salida de los CSV. El service (FastAPI) escribe en un subdir por job.
CSV_DIR=data/csv
# CSV exportados de la captura GraphQL in-page (extensión, patrón C).
CAPTURES_DIR=data/captures

# CORS del FastAPI (Fase 4, extensión de navegador). Lista JSON de orígenes
# permitidos; vacío = sin CORS. El CORS lo maneja FastAPI, NUNCA Nginx.
# Ej: CORS_ALLOW_ORIGINS=["https://x.com","chrome-extension://<id>"]
CORS_ALLOW_ORIGINS=[]

# Tamaño de página del backend (afecta la cota de accesos por página).
PAGE_SIZE=20
# Paso default (días) del troceado de búsqueda por sub-ventanas.
SUBWINDOW_DAYS=7

# El tope de cumplimiento (hard_cap=900000) y la ventana (window_s=86400) NO son
# configurables por entorno a propósito (regla #1): son constantes de código en
# config.py. Setearlas acá no tiene efecto; cambiarlas exige editar el código.

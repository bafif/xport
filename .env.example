# Backend de datos: "twscrape" (gratis, default) u "official" (X API v2,
# paga, sin probar contra la API real). Único punto de intercambio scraping ↔ API oficial.
PROVIDER_BACKEND=twscrape

# Cookies de sesión de una cuenta de X aparte de la tuya (backend twscrape).
# NUNCA commitear el .env real.
X_AUTH_TOKEN=
X_CT0=

# Bearer token de la X API v2 oficial (solo backend "official"; se paga por post leído).
X_API_BEARER_TOKEN=

# Carpeta de datos: la misma para el servicio, la CLI y el native host (un solo registro
# del tope). Por defecto ~/.local/share/xport en Linux, %LOCALAPPDATA%\xport en Windows y
# ~/Library/Application Support/xport en macOS. Si la cambiás, que sea una ruta absoluta.
# XPORT_DATA_DIR=

# Rutas de almacenamiento, relativas a la carpeta de datos (absolutas, tal cual). No hace
# falta tocarlas: estos son los valores por defecto. El ledger de auditoría va separado del
# SQLite de datos.
# AUDIT_DB_PATH=audit/ledger.db
# DATA_DB_PATH=tweets.db
# Store de cuentas/cookies de twscrape (separado del ledger y de los datos).
# ACCOUNTS_DB_PATH=accounts.db
# Raíz de salida de los CSV. El service (FastAPI) escribe en un subdir por job.
# CSV_DIR=csv
# CSV exportados de la captura GraphQL in-page (extensión, patrón C).
# CAPTURES_DIR=captures

# CORS del FastAPI (extensión de navegador). Lista JSON de orígenes
# permitidos; vacío = sin CORS. El CORS lo maneja FastAPI, NUNCA Nginx.
# Ej: CORS_ALLOW_ORIGINS=["https://x.com","chrome-extension://<id>"]
CORS_ALLOW_ORIGINS=[]

# Hosts que el servicio acepta (encabezado Host): protege contra DNS rebinding.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Tamaño de página del backend (afecta la cota de accesos por página).
PAGE_SIZE=20
# Paso default (días) del troceado de búsqueda por sub-ventanas.
SUBWINDOW_DAYS=7

# El tope de cumplimiento (hard_cap=900000) y la ventana (window_s=86400) NO son
# configurables por entorno a propósito (regla #1): son constantes de código en
# config.py. Setearlas acá no tiene efecto; cambiarlas exige editar el código.

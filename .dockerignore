# Higiene del build context (deploy/Dockerfile; el contexto es la raíz del repo).
# El runtime solo copia .venv + src, pero `COPY . .` del build stage manda TODO el
# contexto al daemon: mantener afuera secretos, datos, venvs, node_modules y caches.
# NO excluir lo que el build necesita: src/, pyproject.toml, uv.lock, README.md,
# LICENSE, .python-version.

.git
.gitignore
.dockerignore

# Secretos y datos (NUNCA al build context / cache de capas)
.env
.env.*
data
*.db
*.sqlite*

# Python
.venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache

# Node / extensión (no van en la imagen del servicio Python)
extension
node_modules
dist

# No necesarios para construir/instalar el paquete
tests
docs
.planning
.claude
.vscode
